<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Single-file self-contained publish defaults -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <DeployTarget>\\j-nas01\部門_研發二部\QA\tools\BugzillaDumper</DeployTarget>
    <!-- Keep in sync with AppVersion.cs -->
    <AppVersionNumber>0.16</AppVersionNumber>
  </PropertyGroup>

  <Target Name="CopyToDeployTarget" AfterTargets="Publish">
    <Message Text="Copying to $(DeployTarget) ..." Importance="high" />
    <Copy
      SourceFiles="$(PublishDir)BugzillaDumper.exe"
      DestinationFolder="$(DeployTarget)"
      OverwriteReadOnlyFiles="true"
      ContinueOnError="true" />
    <!-- Write version.txt so clients can detect updates -->
    <WriteLinesToFile
      File="$(PublishDir)version.txt"
      Lines="$(AppVersionNumber)"
      Overwrite="true" />
    <Copy
      SourceFiles="$(PublishDir)version.txt"
      DestinationFolder="$(DeployTarget)"
      OverwriteReadOnlyFiles="true"
      ContinueOnError="true" />
    <Message Text="Deploy complete: $(DeployTarget)\BugzillaDumper.exe  [v$(AppVersionNumber)]" Importance="high" />
  </Target>

</Project>
