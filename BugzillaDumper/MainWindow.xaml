<Window x:Class="BugzillaDumper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BugzillaDumper.ViewModels"
        xmlns:conv="clr-namespace:BugzillaDumper.Converters"
        mc:Ignorable="d"
        Title="Bugzilla Dumper"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        Background="#F0F2F5">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4472C4"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2F5496"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#ED7D31"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D7E3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>

        <!-- Button styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6B7280"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#16A34A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bugzilla Dumper" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText"
                               FontSize="12" Foreground="#A8C4E8" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9CA3AF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#D0E4FF">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Not Connected"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection Panel -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="12,12,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="BUGZILLA URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding BugzillaUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://bugzilla.example.com"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Content="Save Settings" Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
                    <Button Content="Search Bugs" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchBugsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Filter Panel -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,8,12,0">
            <Expander Header="Search Filters" IsExpanded="True">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRODUCT" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchProduct, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COMPONENT" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchComponent, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Background="White" Padding="8,5">
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="CONFIRMED"  IsChecked="{Binding StatusConfirmed}"
                                          Margin="0,0,10,2" FontSize="12"/>
                                <CheckBox Content="IN_PROGRESS" IsChecked="{Binding StatusInProgress}"
                                          Margin="0,0,10,2" FontSize="12"/>
                                <CheckBox Content="RESOLVED"   IsChecked="{Binding StatusResolved}"
                                          Margin="0,0,10,2" FontSize="12"/>
                                <CheckBox Content="REOPENED"   IsChecked="{Binding StatusReopened}"
                                          Margin="0,0,0,2"  FontSize="12"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="ASSIGNED TO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchAssignedTo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="SUMMARY KEYWORD" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchSummary, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="10">
                        <TextBlock Text="LIMIT (0=all)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchLimit, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 = fetch all (auto pagination)"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Main Content: Bug List + Detail -->
        <Grid Grid.Row="3" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Bug List -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Title row -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BUG LIST" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding Bugs.Count, Mode=OneWay}"/>
                                    <Run Text=" bugs found"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- List-only export -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="List only:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="JSON" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ExportBugsToJsonCommand}"
                                        Margin="0,0,4,0" FontSize="11" Padding="8,4"/>
                                <Button Content="Excel" Style="{StaticResource SuccessButton}"
                                        Command="{Binding ExportBugsToExcelCommand}"
                                        FontSize="11" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Full dump row -->
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                CornerRadius="5" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Progress / idle text -->
                                <StackPanel VerticalAlignment="Center">
                                    <!-- Idle label -->
                                    <TextBlock FontSize="11" Foreground="#92400E"
                                               Visibility="{Binding IsFetchingAll, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Run FontWeight="SemiBold" Text="Full Dump"/>
                                        <Run Text=" — fetch all details + comments, then export"/>
                                    </TextBlock>
                                    <!-- Progress label -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsFetchingAll, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11" Foreground="#92400E" FontWeight="SemiBold">
                                            <Run Text="Fetching "/>
                                            <Run Text="{Binding FetchProgress, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding FetchTotal, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="{Binding FetchTotal}"
                                                 Value="{Binding FetchProgress}"
                                                 Height="4" Margin="0,4,0,0"
                                                 Foreground="#F97316" Background="#FED7AA"
                                                 BorderThickness="0"
                                                 Visibility="{Binding IsFetchingAll, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="JSON" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ExportFullDumpToJsonCommand}"
                                            IsEnabled="{Binding IsFetchingAll, Converter={StaticResource InverseBool}}"/>
                                    <Button Content="Excel" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                            Style="{StaticResource SuccessButton}"
                                            Command="{Binding ExportFullDumpToExcelCommand}"
                                            IsEnabled="{Binding IsFetchingAll, Converter={StaticResource InverseBool}}"/>
                                    <Button Content="Cancel" FontSize="11" Padding="8,4"
                                            Background="#EF4444" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            Command="{Binding CancelFetchCommand}"
                                            Visibility="{Binding IsFetchingAll, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bug DataGrid with Loading Overlay -->
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Bugs}"
                                  SelectedItem="{Binding SelectedBug}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFF"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  FontSize="12"
                                  ColumnHeaderHeight="34">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="30"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" MinWidth="50"/>
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" Margin="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="NEW">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="ASSIGNED">
                                                                <Setter Property="Background" Value="#FEF9C3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="CLOSED">
                                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="REOPENED">
                                                                <Setter Property="Background" Value="#FFE4E6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#374151"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="NEW">
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="ASSIGNED">
                                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="REOPENED">
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Pri" Binding="{Binding Priority}" Width="55"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="100"/>
                                <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedTo}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Loading Spinner -->
                        <Border Background="#80FFFFFF"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Loading bugs..." FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="#E5E7EB" VerticalAlignment="Stretch"/>

            <!-- Right: Bug Detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BUG DETAIL" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Export JSON" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportDetailToJsonCommand}"
                                    IsEnabled="{Binding SelectedBugDetail, Converter={StaticResource NotNullToBool}}"
                                    Margin="0,0,6,0" FontSize="12" Padding="10,5"/>
                            <Button Content="Export Excel" Style="{StaticResource SuccessButton}"
                                    Command="{Binding ExportDetailToExcelCommand}"
                                    IsEnabled="{Binding SelectedBugDetail, Converter={StaticResource NotNullToBool}}"
                                    FontSize="12" Padding="10,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Detail Content -->
                    <Grid Grid.Row="1">
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding SelectedBugDetail, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="Select a bug from the list" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loading -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Loading details..." FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Detail View -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding SelectedBugDetail, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel DataContext="{Binding SelectedBugDetail}" Margin="0,0,4,0">

                                <!-- Bug Title -->
                                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>

                                <!-- Meta badges -->
                                <WrapPanel Margin="0,0,0,12">
                                    <Border Background="#DBEAFE" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#1D4ED8">
                                            <Run Text="Status: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FEF9C3" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#92400E">
                                            <Run Text="Priority: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Priority}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FFE4E6" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#991B1B">
                                            <Run Text="Severity: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Severity}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#166534">
                                            <Run Text="Resolution: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Resolution}"/>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <!-- Info Grid -->
                                <Border Background="#F8FAFF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bug ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Product" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Product}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Component" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Component}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Version" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Version}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Assigned To" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssignedTo}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Creator" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Creator}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Created" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreationTime}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Last Changed" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LastChangeTime}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="OS / Platform" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12">
                                            <Run Text="{Binding OpSys}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Platform}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Milestone" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding TargetMilestone}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Whiteboard -->
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding Whiteboard, Converter={StaticResource StringNotEmptyToVisibility}}">
                                    <TextBlock Text="WHITEBOARD" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="{Binding Whiteboard}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Comments -->
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                                    <Run Text="Comments ("/>
                                    <Run Text="{Binding Comments.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10"
                                                                Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock FontSize="11" Foreground="White" FontWeight="SemiBold">
                                                                <Run Text="#"/>
                                                                <Run Text="{Binding Count}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CreationTime}" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource PrimaryDarkBrush}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#D0E4FF" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusVersionText" Grid.Column="1"
                           Foreground="#6B8CC4" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
