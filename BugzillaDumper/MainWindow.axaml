<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BugzillaDumper.ViewModels"
        xmlns:conv="using:BugzillaDumper.Converters"
        mc:Ignorable="d"
        x:Class="BugzillaDumper.MainWindow"
        Title="Bugzilla Dumper"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        Background="#F0F2F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bugzilla Dumper" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Name="TitleVersionText"
                               FontSize="12" Foreground="#A8C4E8" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="gitlab-toggle"
                            Command="{Binding ToggleGitLabPanelCommand}"
                            Margin="0,0,14,0"
                            Content="{Binding IsGitLabPanelVisible, Converter={StaticResource GitLabToggleText}}"
                            Background="{Binding IsGitLabPanelVisible, Converter={StaticResource GitLabToggleBackground}}"
                            Foreground="{Binding IsGitLabPanelVisible, Converter={StaticResource GitLabToggleForeground}}"/>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"
                             Fill="{Binding IsConnected, Converter={StaticResource ConnectedBrush}}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#D0E4FF"
                               Text="{Binding IsConnected, Converter={StaticResource ConnectedText}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update Banner -->
        <Border Grid.Row="1"
                Background="#FEF9C3" BorderBrush="#FDE68A" BorderThickness="0,0,0,2"
                Padding="20,8"
                IsVisible="{Binding UpdateAvailable}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="新版本可用：" FontSize="13" Foreground="#92400E" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UpdateVersionText}" FontSize="13" FontWeight="Bold"
                               Foreground="#92400E" Margin="4,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="點擊「立即更新」，程式將自動下載並重啟"
                               FontSize="12" Foreground="#A16207" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Classes="update" Content="立即更新" HorizontalAlignment="Right"
                        Command="{Binding ApplyUpdateCommand}"
                        IsEnabled="{Binding !IsUpdating}"/>
            </Grid>
        </Border>

        <!-- Connection Panel -->
        <Border Grid.Row="2" Classes="card" Margin="12,12,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="BUGZILLA URL" Classes="field-label"/>
                    <TextBox Classes="input"
                             Text="{Binding BugzillaUrl, Mode=TwoWay}"
                             ToolTip.Tip="e.g. https://bugzilla.example.com"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="API KEY" Classes="field-label"/>
                    <TextBox Classes="input"
                             Text="{Binding ApiKey, Mode=TwoWay}"
                             FontFamily="Menlo,Consolas,monospace"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Classes="success" Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
                    <Button Classes="primary" Content="Search Bugs"
                            Command="{Binding SearchBugsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Filter Panel -->
        <Border Grid.Row="3" Classes="card" Margin="12,8,12,0">
            <Expander Header="Search Filters" IsExpanded="True">
                <StackPanel Margin="0,10,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PRODUCT" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchProduct, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="COMPONENT" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchComponent, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="STATUS" Classes="field-label"/>
                            <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                                    CornerRadius="4" Background="White" Padding="8,5">
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox Content="CONFIRMED"   IsChecked="{Binding StatusConfirmed, Mode=TwoWay}"   Margin="0,0,12,0" FontSize="12"/>
                                    <CheckBox Content="IN_PROGRESS" IsChecked="{Binding StatusInProgress, Mode=TwoWay}" Margin="0,0,12,0" FontSize="12"/>
                                    <CheckBox Content="RESOLVED"    IsChecked="{Binding StatusResolved, Mode=TwoWay}"    Margin="0,0,12,0" FontSize="12"/>
                                    <CheckBox Content="REOPENED"    IsChecked="{Binding StatusReopened, Mode=TwoWay}"    Margin="0,0,12,0" FontSize="12"/>
                                    <CheckBox Content="VERIFIED"    IsChecked="{Binding StatusVerified, Mode=TwoWay}"    FontSize="12"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ASSIGNED TO" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchAssignedTo, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REPORTER" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchReporter, Mode=TwoWay}"
                                     ToolTip.Tip="Filter by bug creator (email)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SUMMARY KEYWORD" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchSummary, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="LIMIT (0=all)" Classes="field-label"/>
                            <TextBox Classes="input" Text="{Binding SearchLimit, Mode=TwoWay}"
                                     ToolTip.Tip="0 = fetch all (auto pagination)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                            <TextBlock Text="SORT" Classes="field-label"/>
                            <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                                    CornerRadius="4" Background="White" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="sort" Content="新→舊" GroupName="SortOrder"
                                                 IsChecked="{Binding SortNewestFirst, Mode=TwoWay}"/>
                                    <RadioButton Classes="sort" Content="舊→新" GroupName="SortOrder"
                                                 IsChecked="{Binding !SortNewestFirst, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Main Content: Bug List | Splitter | Detail | Splitter | GitLab -->
        <Grid Grid.Row="4" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Bug List -->
            <Border Grid.Column="0" Classes="card">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BUG LIST" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding Bugs.Count, Mode=OneWay}"/>
                                        <Run Text=" bugs found"/>
                                    </TextBlock>
                                    <Border Background="#FEF9C3" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding ListKeyword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock FontSize="12" Foreground="#92400E">
                                            <Run Text="{Binding ListMatchCount, Mode=OneWay}"/>
                                            <Run Text=" matched"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="List only:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Classes="secondary" Content="JSON"
                                        Command="{Binding ExportBugsToJsonCommand}"
                                        Margin="0,0,4,0" FontSize="11" Padding="8,4"/>
                                <Button Classes="success" Content="Excel"
                                        Command="{Binding ExportBugsToExcelCommand}"
                                        FontSize="11" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                CornerRadius="5" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="#92400E"
                                               IsVisible="{Binding !IsFetchingAll}">
                                        <Run FontWeight="SemiBold" Text="Full Dump"/>
                                        <Run Text=" — fetch all details + comments, then export"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsFetchingAll}">
                                        <TextBlock FontSize="11" Foreground="#92400E" FontWeight="SemiBold">
                                            <Run Text="Fetching "/>
                                            <Run Text="{Binding FetchProgress, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding FetchTotal, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="{Binding FetchTotal}"
                                                 Value="{Binding FetchProgress}"
                                                 Height="4" Margin="0,4,0,0"
                                                 Foreground="#F97316" Background="#FED7AA"
                                                 IsVisible="{Binding IsFetchingAll}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Classes="secondary" Content="JSON" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                            Command="{Binding ExportFullDumpToJsonCommand}"
                                            IsEnabled="{Binding !IsFetchingAll}"/>
                                    <Button Classes="success" Content="Excel" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                            Command="{Binding ExportFullDumpToExcelCommand}"
                                            IsEnabled="{Binding !IsFetchingAll}"/>
                                    <Button Classes="primary" Content="含附件 (資料夾)" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                            Command="{Binding ExportFullDumpToFolderCommand}"
                                            IsEnabled="{Binding !IsFetchingAll}"/>
                                    <Button Classes="cancel" Content="Cancel" FontSize="11" Padding="8,4"
                                            Command="{Binding CancelFetchCommand}"
                                            IsVisible="{Binding IsFetchingAll}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                                CornerRadius="4" Background="White" Margin="0,8,0,0" Padding="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ListKeyword, Mode=TwoWay}"
                                         BorderThickness="0" Padding="8,5" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         ToolTip.Tip="在目前清單中搜尋關鍵字（ID / 標題 / 元件 / 產品 / 指派人 / 狀態）"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                                        FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                        IsVisible="{Binding ListKeyword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding ClearListKeywordCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bug DataGrid with Loading Overlay -->
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Bugs}"
                                  SelectedItem="{Binding SelectedBug, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  CanUserResizeColumns="True"
                                  FontSize="12"
                                  ColumnHeaderHeight="34">
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                                <Style Selector="DataGridCell">
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                                <Style Selector="DataGridRow">
                                    <Setter Property="MinHeight" Value="30"/>
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36" Header="☑">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" MinWidth="50"/>
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" Margin="2"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Pri" Binding="{Binding Priority}" Width="55"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="100"/>
                                <DataGridTextColumn Header="Assigned To"
                                    Binding="{Binding AssignedTo, Converter={StaticResource EmailToUsername}}" Width="110"/>
                                <DataGridTextColumn Header="Reporter"
                                    Binding="{Binding Creator, Converter={StaticResource EmailToUsername}}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#80FFFFFF" IsVisible="{Binding IsLoading}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Loading bugs..." FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="#E5E7EB" VerticalAlignment="Stretch"/>

            <!-- Right: Bug Detail -->
            <Border Grid.Column="2" Classes="card">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BUG DETAIL" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="secondary" Content="Export JSON"
                                    Command="{Binding ExportDetailToJsonCommand}"
                                    IsEnabled="{Binding SelectedBugDetail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Margin="0,0,6,0" FontSize="12" Padding="10,5"/>
                            <Button Classes="success" Content="Export Excel"
                                    Command="{Binding ExportDetailToExcelCommand}"
                                    IsEnabled="{Binding SelectedBugDetail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    FontSize="12" Padding="10,5"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedBugDetail, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="Select a bug from the list" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding IsDetailLoading}">
                            <TextBlock Text="Loading details..." FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding SelectedBugDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel DataContext="{Binding SelectedBugDetail}" Margin="0,0,4,0">
                                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <Border Background="#DBEAFE" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#1D4ED8">
                                            <Run Text="Status: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FEF9C3" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#92400E">
                                            <Run Text="Priority: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Priority}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FFE4E6" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock FontSize="11" Foreground="#991B1B">
                                            <Run Text="Severity: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Severity}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#166534">
                                            <Run Text="Resolution: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding Resolution}"/>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <Border Background="#F8FAFF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bug ID" Classes="field-label"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Product" Classes="field-label"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Product}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Component" Classes="field-label"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Component}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Version" Classes="field-label"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Version}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Assigned To" Classes="field-label"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssignedTo, Converter={StaticResource EmailToUsername}}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Reporter" Classes="field-label"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Creator, Converter={StaticResource EmailToUsername}}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Created" Classes="field-label"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreationTime}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Last Changed" Classes="field-label"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LastChangeTime}" FontSize="12" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="OS / Platform" Classes="field-label"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12">
                                            <Run Text="{Binding OpSys}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Platform}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Milestone" Classes="field-label"/>
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding TargetMilestone}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="0,0,0,12"
                                            IsVisible="{Binding Whiteboard, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="WHITEBOARD" Classes="field-label"/>
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="{Binding Whiteboard}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                                    <Run Text="Comments ("/>
                                    <Run Text="{Binding Comments.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}"
                                                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10"
                                                                Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock FontSize="11" Foreground="White" FontWeight="SemiBold">
                                                                <Run Text="#"/>
                                                                <Run Text="{Binding Count}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Author, Converter={StaticResource EmailToUsername}}" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CreationTime}" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"
                          Background="#E5E7EB" VerticalAlignment="Stretch"
                          IsVisible="{Binding IsGitLabPanelVisible}"/>

            <!-- GitLab Import Panel -->
            <Border Grid.Column="4" Classes="card" MinWidth="260"
                    IsVisible="{Binding IsGitLabPanelVisible}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="GITLAB IMPORT" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="GITLAB URL" Classes="field-label"/>
                        <TextBox Classes="input" Margin="0,0,0,8"
                                 Text="{Binding GitLabBaseUrl, Mode=TwoWay}"
                                 ToolTip.Tip="e.g. https://gitlab.example.com"/>

                        <TextBlock Text="ACCESS TOKEN" Classes="field-label"/>
                        <TextBox Classes="input" Margin="0,0,0,8"
                                 Text="{Binding GitLabToken, Mode=TwoWay}"
                                 FontFamily="Menlo,Consolas,monospace"/>

                        <TextBlock Text="PROJECT PATH" Classes="field-label"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Classes="input"
                                     Text="{Binding GitLabProjectPath, Mode=TwoWay}"
                                     ToolTip.Tip="e.g. namespace/project"/>
                            <Button Grid.Column="2" Content="驗證" Classes="primary"
                                    Command="{Binding ValidateGitLabProjectCommand}"
                                    FontSize="12" Padding="10,6"/>
                        </Grid>

                        <Border Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="4" Padding="8,5" Margin="0,0,0,12"
                                IsVisible="{Binding IsGitLabProjectValid}">
                            <TextBlock FontSize="11" Foreground="#166534" TextWrapping="Wrap">
                                <Run Text="✓  "/>
                                <Run Text="{Binding GitLabProjectName}"/>
                            </TextBlock>
                        </Border>

                        <Separator Margin="0,2,0,12"/>

                        <TextBlock Text="BUG SELECTION" Classes="field-label"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Classes="secondary" Content="全選"
                                    Command="{Binding SelectAllBugsCommand}"
                                    FontSize="11" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Classes="secondary" Content="全消"
                                    Command="{Binding DeselectAllBugsCommand}"
                                    FontSize="11" Padding="8,4" Margin="0,0,8,0"/>
                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="#1D4ED8">
                                    <Run Text="{Binding SelectedBugCount, Mode=OneWay}"/>
                                    <Run Text=" 已選"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <Button Classes="primary" Content="匯入 GitLab →" Margin="0,0,0,8"
                                Command="{Binding ImportToGitLabCommand}"
                                IsEnabled="{Binding IsGitLabProjectValid}"
                                FontSize="13" Padding="12,8"/>

                        <StackPanel IsVisible="{Binding IsImportingToGitLab}">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                <Run Text="{Binding GitLabImportProgress, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding GitLabImportTotal, Mode=OneWay}"/>
                            </TextBlock>
                            <ProgressBar Minimum="0" Maximum="{Binding GitLabImportTotal}"
                                         Value="{Binding GitLabImportProgress}"
                                         Height="6" Foreground="{StaticResource PrimaryBrush}"
                                         Background="#E0E7FF"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{StaticResource PrimaryDarkBrush}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#D0E4FF" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Name="StatusVersionText" Grid.Column="1"
                           Foreground="#6B8CC4" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
